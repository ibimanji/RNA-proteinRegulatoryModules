WaveletKernel <- function(
    lambda,
    scale = 5
){
  
  scale * lambda *
    exp(-scale * lambda)
  
}
GraphFilterKernel <- function(
    lambda,
    type = c(
      "heat",
      "tikhonov",
      "exponential",
      "wavelet",
      "bandpass",
      "ideal",
      "butterworth",
      "hybrid"
    ),
    beta = 1,
    scale = 5,
    lambda_low = 0.1,
    lambda_high = 1,
    lambda_c = 0.4,
    order = 4,
    gamma = 0.25
){
  
  type <- match.arg(type)
  
  g <- switch(
    
    type,
    
    ########################################################
    ## Heat kernel
    ########################################################
    
    heat =
      exp(
        -beta * lambda
      ),
    
    ########################################################
    ## Tikhonov
    ########################################################
    
    tikhonov =
      1 /
      (
        1 +
          beta * lambda
      ),
    
    ########################################################
    ## Exponential
    ########################################################
    
    exponential =
      exp(
        -beta * sqrt(lambda)
      ),
    
    ########################################################
    ## Spectral graph wavelet
    ########################################################
    
    wavelet =
      lambda *
      exp(
        -scale * lambda
      ),
    
    ########################################################
    ## Band-pass
    ########################################################
    
    bandpass =
      as.numeric(
        lambda > lambda_low &
          lambda < lambda_high
      ),
    
    ########################################################
    ## Ideal low-pass
    ########################################################
    
    ideal =
      as.numeric(
        lambda < beta
      ),
    
    ########################################################
    ## Butterworth low-pass
    ########################################################
    
    butterworth =
      1 /
      (
        1 +
          (lambda / lambda_c)^(2 * order)
      ),
    
    ########################################################
    ## Hybrid:
    ## Heat + Wavelet
    ########################################################
    
    hybrid =
      exp(
        -beta * lambda
      ) +
      gamma *
      lambda *
      exp(
        -scale * lambda
      )
    
  )
  
  ##########################################################
  ## Normalize
  ##########################################################
  
  g <- g / max(g)
  
  g
  
}
GraphWaveletDenoise <- function(
    expr,
    V,
    g
){
  
  g <- g
  
  X <- t(as.matrix(expr))
  
  X_hat <- t(V) %*% X
  
  X_hat_filt <- g * X_hat
  
  X_filt <- V %*% X_hat_filt
  
  X_filt[X_filt < 0] <- 0
  
  t(X_filt)
}

