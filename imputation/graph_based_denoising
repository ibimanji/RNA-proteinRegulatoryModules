  "Nrgn","C1ql2","Wfs1","Chgb",
  "Mbp","Plp1","C1qa","Hexb","Pvalb",
  "Enpp2","Ttr",
  "Ly6c1","Rarres2","Ptgds"
)

############################################################
## Total RNA
############################################################

plot_total <- list()

for(gene in genes_use){
  
  vmax_raw  <- GetVmax(total_raw, gene)
  vmax_wave <- GetVmax(total_wavelet, gene)
  
  plot_total[[length(plot_total)+1]] <-
    PlotSpatialGene2(
      states_tmp,
      gene = gene,
      assay = "total_raw_tmp",
      vmax = vmax_raw,
      title = paste0(gene, "\nTotal Raw")
    )
  
  plot_total[[length(plot_total)+1]] <-
    PlotSpatialGene2(
      states_tmp,
      gene = gene,
      assay = "total_wave_tmp",
      vmax = vmax_wave,
      title = paste0(gene, "\nTotal Wavelet")
    )
}

p_total <- wrap_plots(plot_total, ncol = 2) +
  plot_annotation(title = "Total RNA (ntRNA + rbRNA)")

############################################################
## TE
############################################################

plot_te <- list()

for(gene in genes_use){
  
  vmax_raw  <- GetVmax(te_raw, gene)
  vmax_wave <- GetVmax(te_wave, gene)
  
  plot_te[[length(plot_te)+1]] <-
    PlotSpatialGene2(
      states_tmp,
      gene = gene,
      assay = "te_raw_tmp",
      vmax = vmax_raw,
      title = paste0(gene, "\nTE Raw")
    )
  
  plot_te[[length(plot_te)+1]] <-
    PlotSpatialGene2(
      states_tmp,
      gene = gene,
      assay = "te_wave_tmp",
      vmax = vmax_wave,
      title = paste0(gene, "\nTE Wavelet")
    )
}

p_te <- wrap_plots(plot_te, ncol = 2) +
  plot_annotation(title = "Translation Efficiency")

############################################################
## Save
############################################################

ggsave(
  filename = "TotalRNA_Wavelet2.pdf",
  plot = p_total,
  width = 18,
  height = 49
)

ggsave(
  filename = "TE_Wavelet2.pdf",
  plot = p_te,
  width = 18,
  height = 49
)

