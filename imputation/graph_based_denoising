ComputeGraphSpectrum <- function(
    W,
    n_eigs = 300
){
  
  D <- Matrix::rowSums(W)
  
  D_inv <- Diagonal(
    x = 1/sqrt(D+1e-8)
  )
  
  L <- Diagonal(nrow(W)) -
    D_inv %*%
    W %*%
    D_inv
  
  eig <- eigs_sym(
    L,
    k=n_eigs,
    which="SM"
  )
  
  list(
    lambda=eig$values,
    V=eig$vectors
  )
}
